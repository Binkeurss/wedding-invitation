# Sao chép thành .env.local khi chạy thử (vercel dev). Trên Vercel: Project > Settings > Environment Variables.
# TUYỆT ĐỐI không commit .env / .env.local.
SIGNING_SECRET=chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
INVITE_KEYS=khoa-moi-1,khoa-moi-2
CLOUDINARY_CLOUD=ten-cloud
CLOUDINARY_API_SECRET=api-secret-cloudinary

# Mỗi ảnh là 1 dòng riêng. Format:
# CLOUDINARY_IMAGE_<TEN_ANH>=<public_id>|<ext>|<transform>
# - <public_id>: public_id trên Cloudinary, ví dụ: wedding/hero
# - <ext>: tùy chọn, mặc định là jpg
# - <transform>: tùy chọn, ví dụ: c_limit,w_1400,q_auto
CLOUDINARY_IMAGE_hero=wedding/hero|jpg|c_limit,w_1400,q_auto
CLOUDINARY_IMAGE_story1=wedding/story1|jpg
CLOUDINARY_IMAGE_story2=wedding/story2|jpg
CLOUDINARY_IMAGE_story3=wedding/story3|jpg
CLOUDINARY_IMAGE_album1=wedding/album1|jpg
CLOUDINARY_IMAGE_album2=wedding/album2|jpg
CLOUDINARY_IMAGE_album3=wedding/album3|jpg
CLOUDINARY_IMAGE_album4=wedding/album4|jpg
CLOUDINARY_IMAGE_album5=wedding/album5|jpg
CLOUDINARY_IMAGE_album6=wedding/album6|jpg
CLOUDINARY_IMAGE_album7=wedding/album7|jpg
CLOUDINARY_IMAGE_album8=wedding/album8|jpg
CLOUDINARY_IMAGE_thanks=wedding/thanks|jpg
CLOUDINARY_IMAGE_photo=wedding/photo|png
CLOUDINARY_IMAGE_ic_rings=wedding/ic-rings|svg
CLOUDINARY_IMAGE_ic_car=wedding/ic-car|svg
CLOUDINARY_IMAGE_ic_dinner=wedding/ic-dinner|svg
CLOUDINARY_IMAGE_ic_couple=wedding/ic-couple|svg

# Nếu bạn muốn giữ cách cũ, vẫn hỗ trợ IMAGE_MAP JSON:
# IMAGE_MAP={"hero":{"id":"wedding/hero","ext":"jpg","t":"c_limit,w_1400,q_auto"},"story1":{"id":"wedding/story1","ext":"jpg"}}

# Tuỳ chọn:
# ALLOWED_ORIGINS=https://thiep.ten-ban.com
# TTL_SECONDS=3600
